# Copy to `.env` (which git ignores) for local settings. On the VPS these
# variables are supplied by systemd instead (/etc/spacewx-collector.env).
# Every variable is optional.

# SQLite file location. Default: data/spacewx.sqlite (relative to project root).
# On the VPS use an absolute path outside the code folder, e.g.:
# SPACEWX_DB_PATH=/var/lib/spacewx/spacewx.sqlite

# healthchecks.io ping URL. If the collector stops pinging, you get an email.
# SPACEWX_HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here

# How the collector identifies itself to NOAA's servers.
# SPACEWX_USER_AGENT=spacewx-collector (your name / contact)
